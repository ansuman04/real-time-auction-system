    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.10.1",
    "@types/pg": "8.15.6",
    "socket.io-client": "^4.8.4",
